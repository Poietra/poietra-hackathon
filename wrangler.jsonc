{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poietra-hackathon",
  "account_id": "1c93af48e1a5c2e163edc9030cff4647",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "poietra.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/studio", "/studio/", "/studio/index.html", "/ja", "/ja/", "/ja/index.html", "/api/*", "/sync/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProjectRoom" }, { "name": "AUTH_RECORDS", "class_name": "AuthRecord" }, { "name": "USER_ACCOUNTS", "class_name": "UserAccount" }]
  },
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "poietra-assets-prod" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }, { "tag": "v2-accounts", "new_sqlite_classes": ["AuthRecord", "UserAccount"] }],
  "vars": { "AUTH_ORIGIN": "https://poietra.com", "OPENAI_MODEL": "gpt-6-astra", "OPENAI_IMAGE_MODEL": "gpt-image-1", "OPENAI_IMAGE_QUALITY": "medium", "OPENAI_REASONING_EFFORT": "medium", "OPENAI_SERVICE_TIER": "fast" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "ratelimits": [{
    "name": "AUTH_LIMIT",
    "namespace_id": "1002",
    "simple": { "limit": 20, "period": 60 }
  }, {
    "name": "AI_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 6, "period": 60 }
  }]
}
