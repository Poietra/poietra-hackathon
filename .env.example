# Optional: AI editing. Keep the key on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional: pictures that @codex generates and places as image objects.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Optional: response speed. Effort none/minimal/low/medium/high; tier fast/ultrafast/priority/flex. "default" or "off" removes the parameter.
OPENAI_REASONING_EFFORT=medium
OPENAI_SERVICE_TIER=fast
# Port for the web editor, WebSocket sync, and API.
PORT=5173
# Document snapshots are stored here.
POIETRA_DATA_DIR=.data
